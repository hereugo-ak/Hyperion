# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment
.env
.env.local
.env.*.local

# Reports (generated PDFs — gitignored per §9)
reports/*
!reports/.gitkeep

# Assets (cached images, downloaded fonts — gitignored per §9)
assets/images/*
!assets/images/.gitkeep
assets/fonts/*
!assets/fonts/.gitkeep
!assets/fonts/README.md
# Fix 3.1 (audit §3.8): the blanket `assets/fonts/*` ignore structurally
# guaranteed the font pipeline could never be fixed — no .ttf could ever be
# committed, so every report shipped in DejaVu. The brand fonts are now
# VENDORED (fix 3.2 embeds them into the shipped CSS), so whitelist exactly
# the files the pipeline needs while keeping future downloads ignored.
!assets/fonts/InstrumentSerif-Regular.ttf
!assets/fonts/InstrumentSerif-Italic.ttf
!assets/fonts/SourceSans3-Regular.ttf
!assets/fonts/SourceSans3-Bold.ttf
!assets/fonts/SourceSans3-Italic.ttf
!assets/fonts/JetBrainsMono-Regular.ttf
!assets/fonts/JetBrainsMono-Bold.ttf

# Vault content (accumulates over time — keep structure, ignore content)
vault/engagements/*
!vault/engagements/.gitkeep
vault/markets/*
!vault/markets/.gitkeep
vault/competitors/*
!vault/competitors/.gitkeep

# Keep vault frameworks and sources (seed content is version-controlled)
# vault/frameworks/ — tracked
# vault/sources/ — tracked

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs
*.log
logs/

artifacts/
output/*.html
output/*.css
output/*.pdf
test_full_render*
test_render*
*.sqlite
*.sqlite-shm
*.sqlite-wal

/output/

# Second Brain vector store, created at runtime by vector_brain.py
vault/.embeddings.db

# Engine-health tracker state, created at runtime (F-04 sweep/cooldown bookkeeping)
vault/engine_health.json

# OVERHAUL4 P9: Linux obscura binaries — run-location artifacts (the Windows
# .exe is tracked; the WSL native builds are per-machine downloads).
obscura-bin/obscura
obscura-bin/obscura-worker

# Grounding-quota runtime state (regenerated per engagement; the .lock is
# written by the same ledger path and must not be committed either).
vault/grounding_quota.json
vault/grounding_quota.json.lock
